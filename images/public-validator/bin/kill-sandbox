#!/usr/bin/python3 -I
import os
import signal
import sys

SANDBOX_UID = 10001
MAX_ROUNDS = 10000


def sandbox_pids() -> list[int]:
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            with open(f"/proc/{entry}/status") as handle:
                fields = dict(line.split(":", 1) for line in handle.read().splitlines() if ":" in line)
        except OSError:
            continue
        state = fields.get("State", "").split()[:1]
        if str(SANDBOX_UID) in fields.get("Uid", "").split() and state not in (["Z"], ["X"]):
            pids.append(int(entry))
    return pids


def kill_all() -> bool:
    for _ in range(MAX_ROUNDS):
        pids = sandbox_pids()
        if not pids:
            return True
        for pid in pids:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    return False


# Real and saved uid 0 keep this process out of the sandbox's signal and ptrace reach.
os.setresuid(0, SANDBOX_UID, 0)
if os.getresuid() != (0, SANDBOX_UID, 0):
    sys.exit("kill-sandbox: cannot take the sandbox effective uid")
print("ready", flush=True)
for _ in sys.stdin:
    print("done" if kill_all() else "failed", flush=True)
