#!/usr/bin/env bash
# Build-time only: installs the pinned Claude Code plugins into $HOME/.claude.
set -euo pipefail

add_pinned() {
  local repo=$1 sha=$2 dir
  dir=$(mktemp -d)
  git clone --quiet --filter=blob:none "https://github.com/${repo}.git" "$dir"
  git -C "$dir" checkout --quiet "$sha"
  claude plugin marketplace add "$dir"
}

# The official marketplace name only accepts its GitHub source, so pin by checking out the commit afterwards.
claude plugin marketplace add anthropics/claude-plugins-official
official="$HOME/.claude/plugins/marketplaces/claude-plugins-official"
git -C "$official" fetch --quiet origin 465f09344424225c25d438f2e052732c3d688d2f
git -C "$official" checkout --quiet 465f09344424225c25d438f2e052732c3d688d2f

add_pinned mksglu/context-mode 442f1eb6c7cdad3f0cb2411d00756f9e5cf2b587

claude plugin marketplace add /opt/agent/marketplace

for plugin in \
  typescript-lsp@claude-plugins-official \
  pyright-lsp@claude-plugins-official \
  gopls-lsp@claude-plugins-official \
  rust-analyzer-lsp@claude-plugins-official \
  kotlin-lsp@claude-plugins-official \
  lua-lsp@claude-plugins-official \
  swift-lsp@claude-plugins-official \
  runner@agent-stack \
  context-mode@context-mode; do
  claude plugin install "$plugin" --scope user
done
