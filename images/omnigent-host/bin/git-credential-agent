#!/usr/bin/env bash
# git credential helper: answers github.com requests from the token files the minter keeps fresh.
set -euo pipefail

[ "${1:-}" = get ] || exit 0

host="" path=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    host) host=$value ;;
    path) path=$value ;;
  esac
done

[ "$host" = github.com ] || exit 0

file=${GH_TOKEN_FILE:-/agent-secrets/github/code}
fallback=${GIT_TOKEN:-}
case "$path" in
  lkshrk/knowledge | lkshrk/knowledge.git) file=${KNOWLEDGE_TOKEN_FILE:-/agent-secrets/github/knowledge} fallback= ;;
esac

# Omnigent's workspace-prep init container has no token mount, only envFrom (GIT_TOKEN).
if [ -r "$file" ]; then
  token=$(cat "$file")
else
  token=$fallback
fi
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
