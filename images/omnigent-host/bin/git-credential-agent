#!/usr/bin/env bash
# git credential helper: answers github.com requests from the token files the minter keeps fresh.
set -euo pipefail

[ "${1:-}" = get ] || exit 0

host="" path=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    host) host=$value ;;
    path) path=$value ;;
  esac
done

[ "$host" = github.com ] || exit 0

file=${GH_TOKEN_FILE:-/agent-secrets/github/code}
case "$path" in
  lkshrk/knowledge | lkshrk/knowledge.git) file=${KNOWLEDGE_TOKEN_FILE:-/agent-secrets/github/knowledge} ;;
esac

[ -r "$file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$file")"
