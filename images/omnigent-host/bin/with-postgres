#!/usr/bin/env bash
# Usage: with-postgres <command...>  runs the command against a throwaway PostgreSQL 18.
set -euo pipefail

bin=/usr/lib/postgresql/18/bin
port=${PGPORT:-55432}
db=${PG_DB:-app}
user=${PG_USER:-app}
dir=$(mktemp -d /tmp/pg.XXXXXX)

as_pg() { if [[ $(id -u) -eq 0 ]]; then runuser -u postgres -- "$@"; else "$@"; fi; }
cleanup() {
  as_pg "$bin/pg_ctl" -D "$dir/data" -m immediate stop >/dev/null 2>&1 || true
  rm -rf "$dir"
}
trap cleanup EXIT
[[ $(id -u) -ne 0 ]] || chown postgres "$dir"

as_pg "$bin/initdb" -D "$dir/data" -U "$user" --auth=trust -E UTF8 >/dev/null
as_pg "$bin/pg_ctl" -D "$dir/data" -l "$dir/log" -w \
  -o "-k $dir -c listen_addresses=127.0.0.1 -p $port -c fsync=off -c synchronous_commit=off -c full_page_writes=off" start >/dev/null \
  || { cat "$dir/log" >&2; exit 1; }
[[ $db == postgres ]] || as_pg "$bin/createdb" -h 127.0.0.1 -p "$port" -U "$user" "$db"

export PGHOST=127.0.0.1 PGPORT=$port PGUSER=$user PGDATABASE=$db
export DATABASE_URL="postgresql://$user@127.0.0.1:$port/$db"

set +e
"$@"
rc=$?
exit "$rc"
