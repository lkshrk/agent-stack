#!/usr/bin/env bash
set -euo pipefail

base=${LITELLM_BASE_URL:-}
base=${base%/}

render() {
  sed -e "s#\${LITELLM_BASE_URL}#${base}#g" \
      -e "s#\${OPENAI_BASE_URL}#${base}/v1#g" "$1" >"$2"
}

mkdir -p "$HOME/.claude/plugins"
cp -a --remove-destination /opt/agent/claude-home/.claude/plugins/. "$HOME/.claude/plugins/"
mkdir -p "$HOME/.codex"
cp /opt/agent/codex-home/AGENTS.md "$HOME/.codex/AGENTS.md"
cp /opt/agent/codex-home/security-review.config.toml "$HOME/.codex/security-review.config.toml"
cp -a /opt/agent/agents-home/.agents "$HOME/"
mkdir -p "$HOME/.omp/agent"
cp /opt/agent/omp-home/config.yml "$HOME/.omp/agent/config.yml"
cp /opt/agent/codex-home/AGENTS.md "$HOME/.omp/agent/AGENTS.md"

if [ -z "$base" ]; then
  echo "seed-agent-home: LITELLM_BASE_URL unset; skipping gateway config for Claude Code, Codex and omp" >&2
  exit 0
fi
render /opt/agent/codex-home/config.toml.tmpl "$HOME/.codex/config.toml"
render /opt/agent/omp-home/models.yml.tmpl "$HOME/.omp/agent/models.yml"
render /opt/agent/omp-home/mcp.json.tmpl "$HOME/.omp/agent/mcp.json"
