#!/usr/bin/env bash
set -euo pipefail

exec /opt/venv/bin/python3 -I - "$@" <<'PY'
import json
import sys
from pathlib import Path

from agent_stack_policies.contribution_checkout import CheckoutError, prepare_checkout
from agent_stack_policies.public_contributions import CONTRIBUTION_WORKSPACE, Registry, RegistryError

REGISTRY_PATH = Path("/opt/agent-stack/public-contributions.yaml")


def emit(value: dict | list[str], status: int = 0) -> None:
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    raise SystemExit(status)


def main(argv: list[str]) -> None:
    try:
        registry = Registry.load(REGISTRY_PATH)
    except RegistryError as error:
        emit({"error": str(error)}, 1)

    if argv == ["list"]:
        emit([item.name for item in registry.repositories])

    if len(argv) == 2 and argv[0] == "prepare":
        try:
            item = registry.repository(argv[1])
        except RegistryError as error:
            emit({"error": str(error)}, 2)
        try:
            result = prepare_checkout(item, CONTRIBUTION_WORKSPACE)
        except CheckoutError as error:
            emit({"error": str(error)}, 1)
        emit({"operation": "prepare", "registry_hash": registry.revision, "repo": item.name, **result})

    emit({"error": "usage: agent-stack-contribute list|prepare <repo>"}, 2)


if __name__ == "__main__":
    main(sys.argv[1:])
PY
