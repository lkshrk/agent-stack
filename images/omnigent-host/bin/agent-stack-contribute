#!/usr/bin/env bash
set -euo pipefail

exec /opt/venv/bin/python3 - "$@" <<'PY'
import json
import sys
from pathlib import Path

from agent_stack_policies.public_contributions import Registry, RegistryError

REGISTRY_PATH = Path("/opt/agent-stack/public-contributions.yaml")


def emit(value: dict | list[str], status: int = 0) -> None:
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    raise SystemExit(status)


def repository(registry: Registry, name: str):
    try:
        return registry.repository(name)
    except RegistryError as error:
        emit({"error": str(error)}, 2)


def main(argv: list[str]) -> None:
    try:
        registry = Registry.load(REGISTRY_PATH)
    except RegistryError as error:
        emit({"error": str(error)}, 1)

    if argv == ["list"]:
        emit([item.name for item in registry.repositories])

    if len(argv) == 2 and argv[0] in {"prepare", "preflight"}:
        item = repository(registry, argv[1])
        emit({"operation": argv[0], "registry_hash": registry.revision, "repo": item.name})

    if len(argv) == 3 and argv[0] == "validate":
        item = repository(registry, argv[1])
        try:
            profile = item.validation_profile(argv[2])
        except RegistryError as error:
            emit({"error": str(error)}, 2)
        emit(
            {
                "operation": "validate",
                "profile": profile.name,
                "registry_hash": registry.revision,
                "repo": item.name,
            }
        )

    emit({"error": "usage: agent-stack-contribute list|prepare <repo>|preflight <repo>|validate <repo> <profile>"}, 2)


if __name__ == "__main__":
    main(sys.argv[1:])
PY
