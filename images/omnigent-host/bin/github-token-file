#!/bin/sh
# Agent tool shells don't inherit the pod's GH_TOKEN_FILE, so the agent's git key is picked by which token file is mounted.
if [ -n "${GH_TOKEN_FILE:-}" ]; then
  printf '%s\n' "$GH_TOKEN_FILE"
  exit 0
fi
for key in code hcloud review; do
  if [ -e "/agent-secrets/github/$key" ]; then
    printf '%s\n' "/agent-secrets/github/$key"
    exit 0
  fi
done
printf '%s\n' /agent-secrets/github/code
