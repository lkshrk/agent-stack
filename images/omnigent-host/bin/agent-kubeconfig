#!/bin/sh
set -eu

sa=/var/run/secrets/kubernetes.io/serviceaccount
[ -r "$sa/token" ] && [ -n "${HOME:-}" ] || exit 1
namespace=default
if [ -r "$sa/namespace" ]; then
  namespace=$(cat "$sa/namespace")
fi
dir=$HOME/.kube
config=$dir/in-cluster.yaml
mkdir -p "$dir"
tmp=$(mktemp "$dir/.in-cluster.XXXXXX")
cat >"$tmp" <<YAML
apiVersion: v1
kind: Config
clusters:
- name: in-cluster
  cluster:
    server: https://kubernetes.default.svc
    certificate-authority: $sa/ca.crt
users:
- name: service-account
  user:
    tokenFile: $sa/token
contexts:
- name: in-cluster
  context:
    cluster: in-cluster
    user: service-account
    namespace: "$namespace"
current-context: in-cluster
YAML
mv -f "$tmp" "$config"
printf '%s\n' "$config"
