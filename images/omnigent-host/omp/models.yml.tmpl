providers:
  local-agents:
    baseUrl: ${LITELLM_BASE_URL}
    apiKey: LITELLM_API_KEY
    auth: apiKey
    authHeader: true
    api: openai-completions
    discovery:
      type: litellm
    modelOverrides:
      anthropic/claude-opus:
        api: anthropic-messages
      anthropic/claude-sonnet:
        api: anthropic-messages
      anthropic/claude-haiku:
        api: anthropic-messages
      anthropic/claude-fable:
        api: anthropic-messages
