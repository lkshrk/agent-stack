#!/bin/sh
# Installs the h-cloud update tools from mise.toml into /usr/local/bin; mise itself is not left on PATH, so a project .mise.toml can't swap them.
set -eu

# mise's release-signing key, published in jdx/mise's minisign.pub and install docs.
MISE_MINISIGN_KEY=RWTC3g8W3z4RZK3V3qv7fa1QY4JEWyBtqIHW+85QlJpZc5yG+uNYNBSZ # gitleaks:allow

export MISE_DATA_DIR=/opt/mise MISE_CONFIG_DIR=/etc/mise MISE_CACHE_DIR=/tmp/mise-cache \
  MISE_GLOBAL_CONFIG_FILE=/etc/mise/config.toml MISE_YES=1

apt-get update
apt-get install -y --no-install-recommends skopeo minisign
rm -rf /var/lib/apt/lists/*

release="https://github.com/jdx/mise/releases/download/${MISE_VERSION}"
mkdir /tmp/mise-dl
curl -fsSL "${release}/SHASUMS256.txt" -o /tmp/mise-dl/SHASUMS256.txt
curl -fsSL "${release}/SHASUMS256.txt.minisig" -o /tmp/mise-dl/SHASUMS256.txt.minisig
curl -fsSL "${release}/mise-${MISE_VERSION}-linux-x64" -o "/tmp/mise-dl/mise-${MISE_VERSION}-linux-x64"
minisign -Vm /tmp/mise-dl/SHASUMS256.txt -P "$MISE_MINISIGN_KEY"
(cd /tmp/mise-dl && grep -E "^[0-9a-f]{64}  \./mise-${MISE_VERSION}-linux-x64\$" SHASUMS256.txt | sha256sum -c -)
mv "/tmp/mise-dl/mise-${MISE_VERSION}-linux-x64" /tmp/mise
chmod 0755 /tmp/mise
install -D -m 0644 "$1" /etc/mise/config.toml
cd /
/tmp/mise install
for bin in kubectl flux helm yq crane flate just gh rg; do
  ln -sf "$(/tmp/mise which "$bin")" "/usr/local/bin/$bin"
done
rm -rf /tmp/mise /tmp/mise-dl /tmp/mise-cache /root/.cache
chmod -R a+rX /opt/mise
for bin in kubectl flux helm yq crane flate just gh rg skopeo; do
  command -v "$bin" >/dev/null
done
