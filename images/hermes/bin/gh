#!/usr/bin/env bash
# Re-reads the rotated token on every call and picks it by the repository the call names (-R, --repo, `api repos/<owner>/<repo>`) or the checkout's origin.
set -euo pipefail

repo="" prev=""
for arg in "$@"; do
  case "$prev" in -R | --repo) repo=$arg ;; esac
  case "$arg" in
    --repo=*) repo=${arg#--repo=} ;;
    repos/*/*) [ -n "$repo" ] || repo=$(cut -d/ -f2-3 <<<"$arg") ;;
  esac
  prev=$arg
done
if [ -z "$repo" ] && url=$(git remote get-url origin 2>/dev/null); then
  repo=$(sed -E 's#^(https://github\.com/|git@github\.com:)##; s#\.git$##' <<<"$url")
fi
repo=${repo#https://github.com/}
file=$(/opt/agent/bin/github-token-file "$repo")
if [ -z "${GH_TOKEN:-}" ] && [ -r "$file" ]; then
  GH_TOKEN=$(cat "$file")
  export GH_TOKEN
fi
exec /usr/local/bin/gh "$@"
