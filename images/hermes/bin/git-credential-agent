#!/usr/bin/env bash
# git credential helper: answers github.com requests from the token files the minter keeps fresh.
set -euo pipefail

[ "${1:-}" = get ] || exit 0

host="" path=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    host) host=$value ;;
    path) path=$value ;;
  esac
done

[ "$host" = github.com ] || exit 0

repo=$(cut -d/ -f1-2 <<<"$path")
file=$(/opt/agent/bin/github-token-file "$repo")
[ -r "$file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$file")"
