#!/usr/bin/env bash
# git credential helper: answers github.com requests from the mounted token file.
set -euo pipefail

[ "${1:-}" = get ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = host ] && host=$value
done

[ "$host" = github.com ] || exit 0

file=${GH_TOKEN_FILE:-/var/run/agent/github/token}
[ -r "$file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$file")"
