{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>lkshrk/gh-ops//renovate/presets/app-library.json5',
    'github>lkshrk/gh-ops//renovate/presets/automerge-major.json5',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],
  postUpdateOptions: ['gomodTidy'],
  customManagers: [
    {
      customType: 'regex',
      description: 'Base images pinned as Dockerfile ARG defaults (image:tag@digest)',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG [A-Z_]+_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG MISE_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'jdx/mise',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG USEFUL_SKILLS_VERSION=(?<currentValue>[^@\\s]+)@(?<currentDigest>[0-9a-f]{40})'],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'lkshrk/useful-skills',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG OBSIDIAN_WIKI_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'pypi',
      depNameTemplate: 'obsidian-wiki',
    },
    {
      customType: 'jsonata',
      description: 'Claude Code plugin pins in the LiteLLM skills seed',
      fileFormat: 'json',
      managerFilePatterns: ['/(^|/)deploy/litellm/skills-seed\\.json$/'],
      matchStrings: [
        // Tagged refs (v1.2.3, 1.2.3, or monorepo tags like @scope/pkg@1.2.3) follow tags; a branch ref follows its head.
        '$[source.ref and source.sha].( $repo := source.repo ? source.repo : $replace($replace(source.url, "https://github.com/", ""), /\\.git$/, ""); $tagged := $contains(source.ref, /^v?\\d|@v?\\d+\\.\\d/); { "depName": $repo, "packageName": $tagged ? $repo : "https://github.com/" & $repo, "datasource": $tagged ? "github-tags" : "git-refs", "currentValue": source.ref, "currentDigest": source.sha } )',
      ],
    },
    {
      customType: 'regex',
      description: 'Versions annotated with a renovate comment in workflow env',
      managerFilePatterns: ['/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z_]+:\\s*"?(?<currentValue>v?\\d[\\w.+-]*)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'The gateway offers the skills seed plugins to every Claude Code client; the owner merges these bumps',
      matchManagers: ['custom.jsonata'],
      matchFileNames: ['deploy/litellm/skills-seed.json'],
      automerge: false,
    },
    {
      description: 'Branch-tracked Claude Code plugins in the LiteLLM skills seed: their repos move daily, the plugins rarely. Branch heads carry no release timestamp, so no minimum age',
      matchManagers: ['custom.jsonata'],
      matchDatasources: ['git-refs'],
      groupName: 'claude-plugins-branch',
      schedule: ['* * * * 1'],
      minimumReleaseAge: null,
      group: {
        commitMessageTopic: '{{{groupName}}} group',
        commitMessageExtra: '',
      },
    },
    {
      description: 'LiteLLM version the guardrail tests run against; tracks the image h-cloud deploys, not the github actions group',
      matchDepNames: ['ghcr.io/berriai/litellm-database'],
      groupName: 'litellm',
      pinDigests: false,
    },
    {
      description: 'Agent runtimes change behaviour between releases; always review',
      matchDepNames: [
        'docker.io/nousresearch/hermes-agent',
        'ghcr.io/nesquena/hermes-webui',
      ],
      addLabels: ['agent-runtime'],
      automerge: false,
    },
    {
      description: 'hermes-webui imports Hermes internals and supports only the matching Hermes release; bump them together',
      matchDepNames: ['docker.io/nousresearch/hermes-agent', 'ghcr.io/nesquena/hermes-webui'],
      groupName: 'hermes runtime',
    },
    {
      description: 'The mise binary is pinned by checksum in the Dockerfiles; the PR must update MISE_SHA256 too',
      matchDepNames: ['jdx/mise'],
      addLabels: ['checksum-update'],
      automerge: false,
    },
    {
      description: 'useful-skills text drives Hermes, which holds the agent-npa token; the owner merges these bumps',
      matchDepNames: ['lkshrk/useful-skills'],
      automerge: false,
    },
    {
      description: 'Image inputs ship in the published images, so commit them as fixes to trigger a release',
      matchFileNames: ['**/Dockerfile', 'images/hermes/mise.toml'],
      semanticCommitType: 'fix',
    },
  ],
}
