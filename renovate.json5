{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>lkshrk/gh-ops//renovate/presets/app-library.json5',
    'github>lkshrk/gh-ops//renovate/presets/automerge-major.json5',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],
  postUpdateOptions: ['gomodTidy'],
  customManagers: [
    {
      customType: 'regex',
      description: 'Base images pinned as Dockerfile ARG defaults (image:tag@digest)',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG [A-Z_]+_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG MISE_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'jdx/mise',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG OBSIDIAN_WIKI_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'pypi',
      depNameTemplate: 'obsidian-wiki',
    },
  ],
  packageRules: [
    {
      description: 'Agent runtimes change behaviour between releases; always review',
      matchDepNames: [
        'docker.io/nousresearch/hermes-agent',
        'ghcr.io/nesquena/hermes-webui',
      ],
      addLabels: ['agent-runtime'],
      automerge: false,
    },
    {
      description: 'hermes-webui imports Hermes internals and supports only the matching Hermes release; bump them together',
      matchDepNames: ['docker.io/nousresearch/hermes-agent', 'ghcr.io/nesquena/hermes-webui'],
      groupName: 'hermes runtime',
    },
    {
      description: 'Image inputs ship in the published images, so commit them as fixes to trigger a release',
      matchFileNames: ['**/Dockerfile', 'images/hermes/mise.toml'],
      semanticCommitType: 'fix',
    },
  ],
}
