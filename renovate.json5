{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>lkshrk/gh-ops//renovate/presets/app-library.json5', 'helpers:pinGitHubActionDigests', 'docker:pinDigests'],
  postUpdateOptions: ['gomodTidy'],
  customManagers: [
    {
      customType: 'regex',
      description: 'Base images pinned as Dockerfile ARG defaults (image:tag@digest)',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG [A-Z_]+_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'npm CLIs pinned as Dockerfile ARGs',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG CLAUDE_CODE_VERSION=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'npm',
      depNameTemplate: '@anthropic-ai/claude-code',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CODEX_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@openai/codex',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG OMP_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@oh-my-pi/pi-coding-agent',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CONTEXT_MODE_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'context-mode',
    },
    {
      customType: 'regex',
      description: 'GitHub release tools whose checksum must be updated by hand alongside the version',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG RTK_VERSION=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'rtk-ai/rtk',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CBM_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'DeusData/codebase-memory-mcp',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG MISE_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'jdx/mise',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG KUBECTL_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes/kubernetes',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG OBSIDIAN_WIKI_VERSION=(?<currentValue>\\S+)'],
      datasourceTemplate: 'pypi',
      depNameTemplate: 'obsidian-wiki',
    },
    {
      customType: 'regex',
      description: 'Runner image referenced by the sandbox config',
      managerFilePatterns: ['/(^|/)config/omnigent/config\\.yaml$/'],
      matchStrings: ['image: (?<depName>ghcr\\.io/[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?'],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'Agent runtimes change behaviour between releases; always review',
      matchDepNames: [
        '@anthropic-ai/claude-code',
        '@openai/codex',
        '@oh-my-pi/pi-coding-agent',
        'ghcr.io/omnigent-ai/omnigent-host',
        'ghcr.io/omnigent-ai/omnigent-server-kubernetes',
        'docker.io/nousresearch/hermes-agent',
        'ghcr.io/nesquena/hermes-webui',
      ],
      addLabels: ['agent-runtime'],
      automerge: false,
    },
    {
      description: 'hermes-webui imports Hermes internals and supports only the matching Hermes release; bump them together',
      matchDepNames: ['docker.io/nousresearch/hermes-agent', 'ghcr.io/nesquena/hermes-webui'],
      groupName: 'hermes runtime',
    },
    {
      description: 'Release assets are pinned by checksum in the Dockerfile; the PR must update the SHA256 too',
      matchDepNames: ['rtk-ai/rtk', 'DeusData/codebase-memory-mcp'],
      addLabels: ['checksum-update'],
      automerge: false,
    },
  ],
}
